# Rubrik MCP — hardened (distroless) image for GA.
#
# Multi-stage: build the venv on slim, then copy it into a distroless runtime
# with no shell and no package manager. stdio transport, same as Dockerfile.
# See docs/docker.md.
#
# Pin both bases by digest before release.
FROM python:3.12-slim AS build
WORKDIR /app
COPY . /app
RUN python -m venv /venv \
 && /venv/bin/pip install --no-cache-dir . \
 && rm -rf /root/.cache

FROM gcr.io/distroless/python3-debian12:nonroot
COPY --from=build /venv /venv
COPY --from=build /app /app
ENV PATH="/venv/bin:$PATH" \
    RUBRIK_MCP_CONFIG_DIR=/config
VOLUME ["/config"]
# distroless 'nonroot' runs as uid 65532; /config is an anonymous volume unless
# a host dir is mounted (see docs/docker.md for the ownership note).
ENTRYPOINT ["/venv/bin/rubrik-mcp"]
